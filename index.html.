<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TITAN MARKETPLACE — Démonstration</title><style>:root{--navy:#061b39;--blue:#103866;--orange:#ff8200}*{box-sizing:border-box}body{margin:0;background:#eef3f9;font:15px Arial,sans-serif;color:#12233b}header{background:var(--navy);color:white;padding:16px 5%;display:flex;align-items:center;gap:18px;flex-wrap:wrap}header strong{font-size:25px;letter-spacing:1px}header strong span{color:var(--orange)}nav{display:flex;gap:9px;flex-wrap:wrap}button,.btn{border:0;border-radius:7px;padding:11px 15px;background:var(--orange);color:white;cursor:pointer;font-weight:bold}nav button{background:#193c68}nav button:hover,nav button.active{background:var(--orange)}select,input,textarea{padding:11px;border:1px solid #c6d1df;border-radius:7px;max-width:100%}.hero{background:linear-gradient(115deg,#06152e,#0d4173);color:white;padding:60px 6%}.hero h1{font-size:clamp(28px,4vw,48px);max-width:850px}.hero p{max-width:700px;line-height:1.6}.wrap{max-width:1200px;margin:auto;padding:25px 18px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}.card{background:white;border-radius:12px;padding:20px;box-shadow:0 3px 12px #0c315316}.card h3{margin-top:5px}.price{font-size:21px;color:#0b4c7d;font-weight:bold}.tag{display:inline-block;background:#e8f2ff;color:#164f83;padding:6px 10px;border-radius:6px;font-size:12px}.muted{color:#596b80}.hidden{display:none}form{display:grid;gap:12px;max-width:650px}form input,form textarea,form select{width:100%}textarea{min-height:100px}footer{background:#061b39;color:white;text-align:center;padding:24px;margin-top:30px}.notice{background:#fff3d8;border-left:5px solid #ff8200;padding:14px;margin:14px 0;border-radius:6px}#results{margin:15px 0}#lang{background:white;color:#102c4d}.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.emoji{font-size:42px}.section-title{color:#08254a}a{color:inherit}@media(max-width:650px){header{padding:12px}.hero{padding:35px 20px}header strong{font-size:21px}}</style></head><body><header><strong>⚡ TITAN <span>MARKETPLACE</span></strong><nav><button onclick="show('home')" class="active" data-nav="home">Accueil</button><button onclick="show('catalog')" data-nav="catalog">Catalogue</button><button onclick="show('suppliers')" data-nav="suppliers">Fournisseurs</button><button onclick="show('rfq')" data-nav="rfq">Demande de devis</button><button onclick="show('ai')" data-nav="ai">TITAN AI</button></nav><select id="lang" aria-label="Langue" onchange="setLanguage()"><option value="fr">Français</option><option value="en">English</option><option value="es">Español</option><option value="pt">Português</option><option value="ar">العربية</option></select></header><section class="hero"><h1 id="headline">La marketplace mondiale pour les acheteurs, les entreprises et les fournisseurs.</h1><p id="subtitle">Découvrez des produits, comparez des offres et demandez des devis. Démonstration gratuite de TITAN MARKETPLACE, basée à Dallas–Fort Worth.</p><div class="row"><button onclick="show('catalog')">Explorer le catalogue →</button><button onclick="show('rfq')">Demander un devis →</button></div></section><main class="wrap"><div class="notice" id="demoNote">MODE DÉMONSTRATION : produits et fournisseurs fictifs. Aucun paiement, aucune commande réelle et aucun envoi de données vers un serveur.</div><section id="home"><h2 class="section-title">Bienvenue sur TITAN MARKETPLACE</h2><div class="grid"><div class="card"><div class="emoji">📦</div><h3>Liquidation & palettes</h3><p>Lots de marchandises et vente en gros.</p><button onclick="show('catalog')">Voir les produits</button></div><div class="card"><div class="emoji">🏭</div><h3>Équipements industriels</h3><p>Machines, équipements et fournitures.</p><button onclick="show('catalog')">Voir les produits</button></div><div class="card"><div class="emoji">💻</div><h3>Électronique</h3><p>Ordinateurs et accessoires.</p><button onclick="show('catalog')">Voir les produits</button></div><div class="card"><div class="emoji">🤝</div><h3>Devenir fournisseur</h3><p>Inscrivez votre entreprise pour tester le formulaire.</p><button onclick="show('suppliers')">S'inscrire</button></div></div></section><section id="catalog" class="hidden"><h2 class="section-title">Catalogue de démonstration</h2><div class="row"><input id="search" placeholder="Rechercher un produit..." oninput="renderProducts()"><select id="category" onchange="renderProducts()"><option value="">Toutes les catégories</option><option>Liquidation</option><option>Industrie</option><option>Électronique</option><option>Maison</option></select></div><p id="results" class="muted"></p><div class="grid" id="products"></div></section><section id="suppliers" class="hidden"><h2 class="section-title">Supplies Dashboard — Inscription fournisseur</h2><p>Testez l'enregistrement local d'un profil fournisseur.</p><form id="supplierForm"><input name="company" required placeholder="Nom de l'entreprise"><input name="contact" required placeholder="Personne de contact"><input name="email" type="email" required placeholder="Adresse e-mail"><select name="sector"><option>Liquidation</option><option>Industrie</option><option>Électronique</option><option>Autres produits</option></select><textarea name="description" placeholder="Description de vos produits"></textarea><button>Enregistrer le fournisseur (démo)</button></form><div id="supplierMessage" role="status"></div><h3>Fournisseurs enregistrés sur cet appareil</h3><div id="supplierList"></div></section><section id="rfq" class="hidden"><h2 class="section-title">Demande de devis (RFQ)</h2><p>Ce formulaire conserve uniquement une copie dans votre navigateur.</p><form id="rfqForm"><input name="buyer" required placeholder="Nom ou entreprise"><input name="email" type="email" required placeholder="E-mail"><input name="product" id="rfqProduct" required placeholder="Produit recherché"><input name="quantity" required placeholder="Quantité souhaitée"><textarea name="details" placeholder="Destination et autres détails"></textarea><button>Enregistrer ma demande (démo)</button></form><div id="rfqMessage" role="status"></div><h3>Demandes enregistrées sur cet appareil</h3><div id="rfqList"></div></section><section id="ai" class="hidden"><h2 class="section-title">🤖 TITAN AI — Assistant de démonstration</h2><div class="card"><p>Cette première version utilise des réponses prédéfinies, sans connexion à une IA externe.</p><div class="row"><button onclick="ask('supplier')">Trouver un fournisseur</button><button onclick="ask('price')">Comparer des prix</button><button onclick="ask('quote')">Demander un devis</button><button onclick="ask('shipping')">Livraison internationale</button></div><p id="aiAnswer" class="notice">Choisissez une question pour tester l'assistant.</p></div></section></main><footer>TITAN MARKETPLACE — Prototype de démonstration • Dallas–Fort Worth, Texas • Aucun service commercial réel activé</footer><script>const productsData=[{name:'Palette de liquidation — lot mixte',category:'Liquidation',price:'Sur devis',icon:'📦'},{name:'Lot de vêtements en gros',category:'Liquidation',price:'Sur devis',icon:'👕'},{name:'Machine de conditionnement',category:'Industrie',price:'Sur devis',icon:'🏭'},{name:'Cuve de mélange industrielle',category:'Industrie',price:'Sur devis',icon:'⚙️'},{name:'Ordinateur portable professionnel',category:'Électronique',price:'Sur devis',icon:'💻'},{name:'Accessoires électroniques en gros',category:'Électronique',price:'Sur devis',icon:'🎧'},{name:'Mobilier de bureau',category:'Maison',price:'Sur devis',icon:'🪑'},{name:'Matériaux de construction',category:'Industrie',price:'Sur devis',icon:'🦺'}];function show(id){for(const section of document.querySelectorAll('main section'))section.classList.toggle('hidden',section.id!==id);document.querySelectorAll('[data-nav]').forEach(b=>b.classList.toggle('active',b.dataset.nav===id));if(id==='catalog')renderProducts();if(id==='suppliers')renderSaved('supplier');if(id==='rfq')renderSaved('rfq');window.scrollTo({top:260,behavior:'smooth'})}function renderProducts(){const term=document.getElementById('search').value.toLowerCase(),cat=document.getElementById('category').value;const filtered=productsData.filter(p=>p.name.toLowerCase().includes(term)&&(!cat||p.category===cat));document.getElementById('results').textContent=filtered.length+' produits fictifs';document.getElementById('products').innerHTML=filtered.map((p)=>`<article class="card"><div class="emoji">${p.icon}</div><span class="tag">${p.category}</span><h3>${p.name}</h3><p class="price">${p.price}</p><button onclick="quoteProduct(${productsData.indexOf(p)})">Demander un devis</button></article>`).join('')}function quoteProduct(i){document.getElementById('rfqProduct').value=productsData[i].name;show('rfq')}function load(key){try{return JSON.parse(localStorage.getItem('titan_'+key)||'[]')}catch{return []}}function save(key,data){try{localStorage.setItem('titan_'+key,JSON.stringify(data));return true}catch{return false}}function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function renderSaved(key){const el=document.getElementById(key==='rfq'?'rfqList':'supplierList');const arr=load(key);el.innerHTML=arr.length?arr.map(x=>`<div class="card" style="margin:8px 0"><strong>${escapeHtml(x.company||x.buyer)}</strong><p>${escapeHtml(x.product||x.sector)} — ${escapeHtml(x.email)}</p></div>`).join(''):'<p class="muted">Aucune donnée enregistrée.</p>'}for(const key of ['supplier','rfq']){document.getElementById(key==='supplier'?'supplierForm':'rfqForm').addEventListener('submit',function(e){e.preventDefault();const data=Object.fromEntries(new FormData(this).entries());const arr=load(key);arr.push(data);const ok=save(key,arr);document.getElementById(key==='supplier'?'supplierMessage':'rfqMessage').textContent=ok?'✓ Enregistré localement sur cet appareil (démonstration).':'Stockage indisponible dans ce navigateur.';if(ok){this.reset();renderSaved(key)}})}function ask(topic){const answers={supplier:'Consultez le catalogue et contactez des fournisseurs vérifiés avant toute transaction. Aucun fournisseur réel n’est connecté à cette démo.',price:'Demandez plusieurs devis pour comparer les prix, les quantités minimales et les frais de livraison.',quote:'Ouvrez la section « Demande de devis », indiquez le produit, la quantité et la destination.',shipping:'Pour une vente internationale, vérifiez les Incoterms, droits de douane, documents et transporteurs.'};document.getElementById('aiAnswer').textContent=answers[topic]}const translations={fr:['La marketplace mondiale pour les acheteurs, les entreprises et les fournisseurs.','Découvrez des produits, comparez des offres et demandez des devis. Démonstration gratuite de TITAN MARKETPLACE, basée à Dallas–Fort Worth.'],en:['The global marketplace for buyers, businesses and suppliers.','Discover products, compare offers and request quotes. Free TITAN MARKETPLACE demo based in Dallas–Fort Worth.'],es:['El mercado global para compradores, empresas y proveedores.','Descubra productos, compare ofertas y solicite presupuestos. Demostración gratuita de TITAN MARKETPLACE.'],pt:['O marketplace global para compradores, empresas e fornecedores.','Descubra produtos, compare ofertas e solicite cotações. Demonstração gratuita da TITAN MARKETPLACE.'],ar:['السوق العالمي للمشترين والشركات والموردين.','اكتشف المنتجات وقارن العروض واطلب عروض الأسعار. نسخة تجريبية مجانية من TITAN MARKETPLACE.']};function setLanguage(){const l=document.getElementById('lang').value;document.getElementById('headline').textContent=translations[l][0];document.getElementById('subtitle').textContent=translations[l][1];document.querySelector('.hero').dir=l==='ar'?'rtl':'ltr'}renderProducts();</script></body></html>
